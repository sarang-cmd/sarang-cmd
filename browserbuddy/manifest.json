{
  "manifest_version": 3,
  "name": "BrowserBuddy",
  "version": "0.1.0",
  "minimum_chrome_version": "120",
  "description": "Set an intention, block selected sites, and reflect on your browsing locally.",
  "permissions": [
    "storage",
    "alarms",
    "declarativeNetRequestWithHostAccess",
    "activeTab",
    "contextMenus"
  ],
  "optional_permissions": [
    "tabs",
    "idle"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open BrowserBuddy",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png"
    }
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html",
        "blocked.js",
        "styles.css",
        "assets/mascot.png",
        "assets/fonts/*"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}
